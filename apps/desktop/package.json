{
  "name": "@switchboard/desktop",
  "productName": "Switchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "icon": "node scripts/icon/build.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "smoke:packaged": "node scripts/smoke.ts --packaged",
    "dist:notarized": "APPLE_KEYCHAIN_PROFILE=switchboard-notary npm run dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "@switchboard/engine": "*",
    "@switchboard/protocol": "*"
  },
  "description": "A fast desktop app for managing Claude Code sessions",
  "author": "Elio Struyf"
}
