{
  "$schema": "https://raw.githubusercontent.com/estruyf/switchboard/main/docs/switchboard-theme.schema.json",
  "$comment": "The unnamed (github.com/estruyf/vscode-unnamed-theme), dark only. Code colours are its tokenColors.",
  "name": "The unnamed",
  "author": "Elio Struyf",
  "version": 1,

  "dark": {
    "canvas": "#0e131f",
    "accent": "#15c2cb",
    "colors": {
      "bg": "#0e131f",
      "sidebar": "#141c2d",
      "card": "#141c2d",
      "popover": "#19233a",
      "code-bg": "#141c2d",
      "border": "#212c36",
      "overlay-border": "#2f3d55",
      "overlay-shadow": "#000000b3",
      "text": "#f3eff5",
      "muted": "#b9b6c0",
      "faint": "#8c8c95",
      "link": "#5eadf2",
      "selected": "#f3eff522",
      "focus-ring": "#15c2cb8c",
      "scrim": "#00000099",
      "ok": "#44ffd2",
      "warn": "#f141a8",
      "error": "#fe4a49",
      "caution": "#ff9f43",
      "unread": "#5eadf2",
      "accent": "#15c2cb",
      "accent-ink": "#15c2cb",
      "on-accent": "#0e131f",
      "diff-added": "#44ffd21f",
      "diff-removed": "#fe4a4924",
      "terminal-bg": "#0a0e17",
      "terminal-shadow": "#0000008c",
      "profile-yellow": "#ffe45e",
      "profile-blue": "#5eadf2",
      "profile-green": "#44ffd2",
      "profile-purple": "#a170c6",
      "profile-red": "#fe6362",
      "profile-orange": "#ff9f43",
      "profile-gray": "#8c8c95"
    },
    "terminal": {
      "background": "#0a0e17",
      "foreground": "#f3eff5",
      "cursor": "#44ffd2",
      "selection": "#f3eff533",
      "ansi": [
        "#141c2d",
        "#fe4a49",
        "#11ffc6",
        "#f5cc00",
        "#46a1f0",
        "#ed1292",
        "#0accd6",
        "#dad6dc",
        "#676965",
        "#fe6362",
        "#44ffd2",
        "#ffe45e",
        "#5eadf2",
        "#f141a8",
        "#15c2cb",
        "#f3eff5"
      ]
    },
    "syntax": {
      "name": "The unnamed",
      "type": "dark",
      "tokenColors": [
        {
          "scope": [
            "meta.paragraph.markdown",
            "string.other.link.description.title.markdown"
          ],
          "settings": { "foreground": "#EEFFFF" }
        },
        {
          "scope": [
            "entity.name.section.markdown",
            "punctuation.definition.heading.markdown"
          ],
          "settings": { "foreground": "#F141A8" }
        },
        {
          "scope": [
            "punctuation.definition.string.begin.markdown",
            "punctuation.definition.string.end.markdown",
            "markup.quote.markdown"
          ],
          "settings": { "foreground": "#11ffc6" }
        },
        {
          "scope": ["markup.quote.markdown"],
          "settings": { "foreground": "#11ffc6", "fontStyle": "italic" }
        },
        {
          "scope": [
            "markup.bold.markdown",
            "punctuation.definition.bold.markdown"
          ],
          "settings": { "foreground": "#5EADF2", "fontStyle": "bold" }
        },
        {
          "scope": [
            "markup.italic.markdown",
            "punctuation.definition.italic.markdown"
          ],
          "settings": { "foreground": "#fe6362", "fontStyle": "italic" }
        },
        {
          "scope": [
            "markup.inline.raw.string.markdown",
            "markup.fenced_code.block.markdown"
          ],
          "settings": { "foreground": "#F5CC00", "fontStyle": "italic" }
        },
        {
          "scope": ["punctuation.definition.metadata.markdown"],
          "settings": { "foreground": "#f3b8c2" }
        },
        {
          "scope": [
            "markup.underline.link.image.markdown",
            "markup.underline.link.markdown"
          ],
          "settings": { "foreground": "#46a1f0" }
        },
        {
          "name": "Comment",
          "scope": "comment",
          "settings": { "foreground": "#f3eff5b8", "fontStyle": "italic" }
        },
        {
          "name": "Quotes",
          "scope": "punctuation.definition.string",
          "settings": { "foreground": "#2affcc" }
        },
        {
          "name": "String",
          "scope": "string",
          "settings": { "foreground": "#44FFD2" }
        },
        {
          "name": "String Quoted",
          "scope": ["string.quoted", "variable.other.readwrite.js"],
          "settings": { "foreground": "#44FFD2", "fontStyle": "" }
        },
        {
          "name": "Number",
          "scope": "constant.numeric",
          "settings": { "foreground": "#0accd6" }
        },
        {
          "name": "Boolean",
          "scope": "constant.language.boolean",
          "settings": { "foreground": "#0accd6" }
        },
        {
          "name": "Constant",
          "scope": "constant",
          "settings": { "foreground": "#A170C6" }
        },
        {
          "name": "Built-in constant",
          "scope": [
            "constant.language",
            "punctuation.definition.constant",
            "variable.other.constant"
          ],
          "settings": { "foreground": "#92b6f4" }
        },
        {
          "name": "User-defined constant",
          "scope": ["constant.character", "constant.other"],
          "settings": { "foreground": "#11ffc6" }
        },
        {
          "name": "Variable",
          "scope": "variable",
          "settings": { "foreground": "#a4ceee", "fontStyle": "italic" }
        },
        {
          "name": "JavaScript Other Variable",
          "scope": "variable.other.object.js",
          "settings": { "foreground": "#F3EFF5", "fontStyle": "italic" }
        },
        {
          "name": "TypeScript[React] Variables and Object Properties",
          "scope": [
            "variable.other.readwrite.alias.ts",
            "variable.other.readwrite.alias.tsx",
            "variable.other.readwrite.ts",
            "variable.other.readwrite.tsx",
            "variable.other.object.ts",
            "variable.other.object.tsx",
            "variable.object.property.ts",
            "variable.object.property.tsx",
            "variable.other.ts",
            "variable.other.tsx",
            "variable.tsx",
            "variable.ts"
          ],
          "settings": { "foreground": "#F3EFF5" }
        },
        {
          "scope": [
            "variable.other.object.property.tsx",
            "variable.other.object.property.ts",
            "variable.other.object.property"
          ],
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "TypeScript Classes",
          "scope": "meta.class entity.name.type.class.tsx",
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "TypeScript Entity Name Type",
          "scope": ["entity.name.type.tsx", "entity.name.type.module.tsx"],
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "TypeScript Method Declaration e.g. `constructor`",
          "scope": [
            "meta.method.declaration storage.type.ts",
            "meta.method.declaration storage.type.tsx"
          ],
          "settings": { "foreground": "#F141A8" }
        },
        {
          "name": "Variable Property Other object property",
          "scope": ["variable.other.object.property"],
          "settings": { "foreground": "#F5CC00", "fontStyle": "italic" }
        },
        {
          "name": "Variable Instances",
          "scope": [
            "variable.instance",
            "variable.other.instance",
            "variable.readwrite.instance",
            "variable.other.readwrite.instance",
            "variable.other.property"
          ],
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "scope": [
            "variable.other.property.ts",
            "variable.other.property.tsx",
            "variable.other.property"
          ],
          "settings": { "foreground": "#B5BFF8", "fontStyle": "" }
        },
        {
          "name": "JavaScript Variable Other ReadWrite",
          "scope": ["variable.other.readwrite.js", "variable.parameter"],
          "settings": { "foreground": "#F3EFF5" }
        },
        {
          "name": "Template Strings",
          "scope": "string.template meta.template.expression",
          "settings": { "foreground": "#F141A8" }
        },
        {
          "name": "Backtics(``) in Template Strings",
          "scope": "string.template punctuation.definition.string",
          "settings": { "foreground": "#ffffff" }
        },
        {
          "name": "Storage",
          "scope": "storage",
          "settings": { "foreground": "#46a1f0", "fontStyle": "" }
        },
        {
          "name": "Keywords and Storage types",
          "scope": ["keyword", "storage.type", "storage.modifier"],
          "settings": { "foreground": "#F141A8", "fontStyle": "italic" }
        },
        {
          "name": "Keywords operators",
          "scope": ["keyword.operator"],
          "settings": { "foreground": "#F141A8", "fontStyle": "italic" }
        },
        {
          "name": "Storage",
          "scope": [
            "storage",
            "meta.class meta.method.declaration meta.var.expr storage.type.js",
            "storage.type.property.js",
            "storage.type.property.ts"
          ],
          "settings": { "foreground": "#FE4A49", "fontStyle": "italic" }
        },
        {
          "name": "JavaScript module imports and exports",
          "scope": [
            "variable.other.meta.import.js",
            "meta.import.js variable.other",
            "variable.other.meta.export.js",
            "meta.export.js variable.other"
          ],
          "settings": { "foreground": "#F3EFF5" }
        },
        {
          "name": "HTML and React content",
          "scope": [
            "meta.var.expr",
            "meta.jsx.children.tsx",
            "meta.tag.tsx",
            "meta.jsx.children.tsx",
            "meta.tag.tsx",
            "meta.block.tsx",
            "meta.arrow.tsx",
            "meta.var.expr.tsx",
            "source.tsx"
          ],
          "settings": { "foreground": "#F3EFF5", "fontStyle": "" }
        },
        {
          "name": "Class name",
          "scope": "entity.name.class",
          "settings": { "foreground": "#F5CC00" }
        },
        {
          "name": "Inherited class",
          "scope": "entity.other.inherited-class",
          "settings": { "foreground": "#5EADF2", "fontStyle": "" }
        },
        {
          "name": "Variables, Let and Const",
          "scope": ["variable.other.readwrites", "meta.definition.variable"],
          "settings": { "foreground": "#F5CC00", "fontStyle": "" }
        },
        {
          "name": "Support Variable Property",
          "scope": "support.variable.property",
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "Function name",
          "scope": "entity.name.function",
          "settings": { "foreground": "#15C2CB", "fontStyle": "italic" }
        },
        {
          "scope": [
            "meta.definition.method entity.name.function",
            "meta.function-call entity.name.function"
          ],
          "settings": { "foreground": "#5EADF2" }
        },
        {
          "name": "Function argument",
          "scope": "variable.parameter",
          "settings": { "foreground": "#F3EFF5", "fontStyle": "" }
        },
        {
          "name": "Tag name",
          "scope": "entity.name.tag",
          "settings": { "foreground": "#46a1f0", "fontStyle": "" }
        },
        {
          "name": "Entity Name Type",
          "scope": "entity.name.type",
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "Tag attribute",
          "scope": "entity.other.attribute-name",
          "settings": { "foreground": "#F5CC00", "fontStyle": "italic" }
        },
        {
          "name": "Meta - Decorator",
          "scope": ["punctuation.decorator"],
          "settings": { "foreground": "#F5CC00", "fontStyle": "italic" }
        },
        {
          "scope": ["constant.language", "variable.language"],
          "settings": { "foreground": "#FFE45E" }
        },
        {
          "name": "Punctuation/Brackets/Tags",
          "scope": [
            "punctuation.definition.block",
            "punctuation.definition.tag"
          ],
          "settings": { "foreground": "#F3EFF5" }
        },
        {
          "name": "Library function",
          "scope": "support.function",
          "settings": { "foreground": "#F5CC00", "fontStyle": "" }
        },
        {
          "name": "Library constant",
          "scope": "support.constant",
          "settings": { "foreground": "#F141A8", "fontStyle": "" }
        },
        {
          "name": "!important keyword",
          "scope": "keyword.other.important.css",
          "settings": { "foreground": "#FE4A49", "fontStyle": "bold" }
        },
        {
          "name": "Library class/type",
          "scope": ["support.type", "support.class"],
          "settings": { "foreground": "#15C2CB" }
        },
        {
          "name": "Library variable",
          "scope": "support.other.variable",
          "settings": { "foreground": "#CBCDD2" }
        },
        {
          "name": "Invalid",
          "scope": "invalid",
          "settings": {
            "foreground": "#46a1f0",
            "fontStyle": " italic bold underline"
          }
        },
        {
          "name": "Invalid deprecated",
          "scope": "invalid.deprecated",
          "settings": {
            "foreground": "#46a1f0",
            "fontStyle": " bold italic underline"
          }
        },
        {
          "name": "JSON Property Names",
          "scope": "support.type.property-name.json",
          "settings": { "foreground": "#5EADF2" }
        },
        {
          "name": "JSON Support Constants",
          "scope": "support.constant.json",
          "settings": { "foreground": "#00f6bb" }
        },
        {
          "name": "JSON Property values (string)",
          "scope": "meta.structure.dictionary.value.json string.quoted.double",
          "settings": { "foreground": "#44FFD2" }
        },
        {
          "name": "Strings in JSON values",
          "scope": "string.quoted.double.json punctuation.definition.string.json",
          "settings": { "foreground": "#80CBC4" }
        },
        {
          "name": "Specific JSON Property values like null",
          "scope": "meta.structure.dictionary.json meta.structure.dictionary.value constant.language",
          "settings": { "foreground": "#0accd6" }
        },
        {
          "name": "[JSON] - Support",
          "scope": "source.json support",
          "settings": { "foreground": "#46a1f0" }
        },
        {
          "name": "[JSON] - String",
          "scope": [
            "source.json string",
            "source.json punctuation.definition.string"
          ],
          "settings": { "foreground": "#44FFD2" }
        },
        {
          "name": "Lists",
          "scope": "markup.list",
          "settings": { "foreground": "#46a1f0" }
        },
        {
          "name": "Headings",
          "scope": [
            "markup.heading punctuation.definition.heading",
            "entity.name.section"
          ],
          "settings": { "foreground": "#5EADF2", "fontStyle": "" }
        },
        {
          "name": "Support",
          "scope": [
            "text.html.markdown meta.paragraph meta.link.inline",
            "text.html.markdown meta.paragraph meta.link.inline punctuation.definition.string.begin.markdown",
            "text.html.markdown meta.paragraph meta.link.inline punctuation.definition.string.end.markdown"
          ],
          "settings": { "foreground": "#50E3C2" }
        },
        {
          "name": "[Markdown] text ",
          "scope": ["meta.paragraph.markdown"],
          "settings": { "foreground": "#F3EFF5" }
        },
        {
          "name": "Quotes",
          "scope": "markup.quote",
          "settings": { "foreground": "#50E3C2", "fontStyle": "italic" }
        },
        {
          "name": "Link Url",
          "scope": "meta.link",
          "settings": { "foreground": "#50E3C2" }
        },
        {
          "name": "Dockerfile",
          "scope": "source.dockerfile",
          "settings": { "foreground": "#99d0f7" }
        }
      ]
    }
  }
}
