{
  "$schema": "https://raw.githubusercontent.com/estruyf/switchboard/main/docs/switchboard-theme.schema.json",
  "$comment": "Ported from Light High Contrast and Dark High Contrast, github.com/microsoft/vscode extensions/theme-defaults/themes (hc_light.json, hc_black.json; MIT, Copyright (c) 2015 - present Microsoft Corporation). Most of their workbench colours are VS Code's high contrast registry defaults (contrastBorder, contrastActiveBorder…), used here. The code colours are their token colours, converted to inline themes.",
  "name": "VS Code High Contrast",
  "author": "Microsoft, ported for Switchboard",
  "version": 1,
  "light": {
    "$comment": [
      "canvas is editor.background, accent is focusBorder (= contrastActiveBorder).",
      "Every surface is the canvas, with contrastBorder on all of them; the focus ring is contrastActiveBorder.",
      "muted: descriptionForeground is foreground at 70% (5.4:1 on white), below AAA, so it is a darker grey that keeps 7:1.",
      "ok is gitDecoration.addedResourceForeground, error is errorForeground, caution is editorWarning.foreground. warn (\"needs you\") is the terminal's magenta #bc05bc. unread is the link colour."
    ],
    "canvas": "#ffffff",
    "accent": "#006bbd",
    "colors": {
      "bg": "#ffffff",
      "sidebar": "#ffffff",
      "card": "#ffffff",
      "popover": "#ffffff",
      "code-bg": "#f2f2f2",
      "border": "#0f4a85",
      "overlay-border": "#0f4a85",
      "focus-ring": "#006bbd",
      "text": "#292929",
      "muted": "#4a4a4a",
      "link": "#0f4a85",
      "ok": "#374e06",
      "warn": "#bc05bc",
      "error": "#b5200d",
      "caution": "#895503",
      "unread": "#0f4a85"
    },
    "syntax": {
      "name": "Light High Contrast",
      "type": "light",
      "tokenColors": [
